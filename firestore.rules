rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function role() { return signedIn() && request.auth.token.role is string ? request.auth.token.role : ""; }
    function isAdmin() { return role() == "admin"; }
    function isStaff() { return role() == "admin" || role() == "operations"; }

    // Roles are Firebase custom claims managed only by the trusted setUserRole function.
    match /users/{userId} { allow get: if signedIn() && request.auth.uid == userId; allow list: if isAdmin(); allow create, update, delete: if false; }
    match /vehicles/{vehicleId} { allow read: if isStaff(); allow write: if false; }
    match /vehicles/{vehicleId}/serviceRecords/{recordId} { allow read: if isStaff(); allow write: if false; }
    match /customers/{customerId} { allow read: if isStaff(); allow write: if false; }
    match /reservations/{reservationId} { allow read: if isStaff(); allow write: if false; }
    match /rentals/{rentalId} { allow read: if isStaff(); allow write: if false; }
    match /rentals/{rentalId}/inspections/{inspectionId} { allow read: if isStaff(); allow write: if false; }

    // Financial, audit, and idempotency data are never exposed to operations staff or browsers for mutation.
    match /rentalFinancials/{rentalId} { allow read: if isAdmin(); allow write: if false; }
    match /payments/{paymentId} { allow read: if isAdmin(); allow write: if false; }
    match /refunds/{refundId} { allow read: if isAdmin(); allow write: if false; }
    match /financialLedger/{entryId} { allow read: if isAdmin(); allow write: if false; }
    match /vehicleExpenses/{expenseId} { allow read: if isAdmin(); allow write: if false; }
    match /auditLogs/{auditId} { allow read: if isAdmin(); allow write: if false; }
    match /idempotencyKeys/{key} { allow read, write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
