rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* =========================================================
       AUTHENTICATION / STAFF
       ========================================================= */

    function signedIn() {
      return request.auth != null;
    }

    function currentUser() {
      return get(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data;
    }

    function approvedUser() {
      return signedIn()
        && currentUser().status == "approved"
        && (
          currentUser().role == "admin"
          || currentUser().role == "operations"
        );
    }

    function isAdmin() {
      return signedIn()
        && currentUser().status == "approved"
        && currentUser().role == "admin";
    }

    function isOperations() {
      return signedIn()
        && currentUser().status == "approved"
        && currentUser().role == "operations";
    }

    function isStaff() {
      return isAdmin() || isOperations();
    }


    /* =========================================================
       APPROVAL REQUESTS
       ========================================================= */

    /* A decision may write only these fields, so nothing that
       was asked for can be changed while deciding it. */
    function decisionFieldsOnly() {
      return request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasOnly([
          "status",
          "reviewedBy",
          "reviewedByNameSnapshot",
          "reviewedAt",
          "reviewNote",
          "updatedAt"
        ]);
    }

    /* An administrator decides a waiting request once, in
       their own name, and never their own request. */
    function adminDecidesPending() {
      return isAdmin()
        && resource.data.status == "pending"
        && request.resource.data.status in [
          "approved",
          "rejected"
        ]
        && decisionFieldsOnly()
        && request.resource.data.reviewedBy
            == request.auth.uid
        && resource.data.requestedBy
            != request.auth.uid;
    }

    /* A rejection always says why. */
    function rejectionExplained() {
      return request.resource.data.status != "rejected"
        || (
          request.resource.data.get("reviewNote", null)
              is string
          && request.resource.data.reviewNote.trim().size()
              > 0
        );
    }

    /* Asked in the caller's own name, waiting, with a reason. */
    function pendingRequestInOwnName() {
      return request.resource.data.status == "pending"
        && request.resource.data.requestedBy
            == request.auth.uid
        && request.resource.data.get("reason", null)
            is string
        && request.resource.data.reason.trim().size() > 0
        && request.resource.data.reason.size() <= 500;
    }


    /* =========================================================
       USERS / STAFF
       ========================================================= */

    match /users/{userId} {

      /* Users can read themselves.
         Admins can read all staff profiles. */
      allow get: if signedIn()
  && request.auth.uid == userId;

/*
 * Administrators can read other staff profiles.
 */
allow get: if isAdmin();

/*
 * Only admins can list staff.
 */
allow list: if isAdmin();

      /* Signup creates its own pending profile.
         A user cannot assign an approved role to itself. */
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.status == "pending"
        && request.resource.data.role == null
        && request.resource.data.requestedRole in [
          "admin",
          "operations"
        ]
        && request.resource.data.email
            == request.auth.token.email;

      /* Pending users may update only their
         registration information. */
      allow update: if signedIn()
        && request.auth.uid == userId
        && resource.data.role
            == request.resource.data.role
        && resource.data.status
            == request.resource.data.status
        && resource.data.requestedRole
            == request.resource.data.requestedRole
        && request.resource.data.diff(
          resource.data
        ).affectedKeys().hasOnly([
          "fullName",
          "mobile",
          "age",
          "email",
          "updatedAt"
        ]);

      /* Only admins can approve, reject,
         or change staff roles. */
      allow update: if isAdmin();

      /* Only admins can remove staff profiles. */
      allow delete: if isAdmin();
    }


    /* =========================================================
       VEHICLES
       ========================================================= */

    match /vehicles/{vehicleId} {

      allow read: if isStaff();

      allow create, update: if isStaff();

      allow delete: if isAdmin();
    }


    match /vehicles/{vehicleId}/serviceRecords/{recordId} {

      allow read: if isStaff();

      allow create, update: if isStaff();

      allow delete: if isAdmin();
    }


    /* =========================================================
       VEHICLE UNIQUENESS CLAIMS
       ========================================================= */

    match /vehicleRegistry/{key} {

      /* One document per registration number and VIN. Two
         concurrent vehicle writes contend on the same claim,
         so exactly one of them can take it. Staff may release
         a claim when a vehicle is renamed. */
      allow read, create, update, delete: if isStaff();
    }


    /* =========================================================
       CUSTOMERS
       ========================================================= */

    match /customers/{customerId} {

      allow read: if isStaff();

      allow create, update: if isStaff();

      allow delete: if isAdmin();
    }


    /* =========================================================
       RESERVATIONS
       ========================================================= */

    function cancellationLockUntouched() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          "cancellationRequestId",
          "cancellationRequestStatus",
          "cancellationRequestedBy",
          "cancellationRequestedByNameSnapshot"
        ]);
    }

    /* Staff point the booking at the request they have just
       written, and only when nothing else is waiting on it. */
    function openingCancellationRequest(reservationId) {
      let requestId =
        request.resource.data.get(
          "cancellationRequestId", null
        );
      let after = getAfter(
        /databases/$(database)/documents/cancellationRequests/$(requestId)
      ).data;

      return resource.data.get(
            "cancellationRequestStatus", null
          ) != "pending"
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "cancellationRequestId",
              "cancellationRequestStatus",
              "updatedAt"
            ])
        && request.resource.data.cancellationRequestStatus
            == "pending"
        && requestId is string
        && after.status == "pending"
        && after.reservationId == reservationId;
    }

    /* Checking a booking out withdraws the cancellation it was
       waiting on. */
    function withdrawingCancellationAtCheckout() {
      return resource.data.get(
            "cancellationRequestStatus", null
          ) == "pending"
        && request.resource.data.status == "checked_out"
        && request.resource.data.cancellationRequestStatus
            == "withdrawn"
        && request.resource.data.cancellationRequestId
            == resource.data.cancellationRequestId;
    }

    /* A discount on the daily rate is the one way a booking's
       daily rate leaves the vehicle's: staff point the booking
       at the discount they have just asked for, and only when
       none is waiting or applied. */
    function discountLockUntouched() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          "dailyRateDiscountId",
          "dailyRateDiscountStatus"
        ]);
    }

    function openingDiscountRequest(reservationId) {
      let discountId =
        request.resource.data.get(
          "dailyRateDiscountId", null
        );
      let after = getAfter(
        /databases/$(database)/documents/rentalDiscounts/$(discountId)
      ).data;

      return !(
          resource.data.get(
            "dailyRateDiscountStatus", null
          ) in ["pending", "approved"]
        )
        && request.resource.data.dailyRateDiscountStatus
            == "pending"
        && discountId is string
        && after.status == "pending"
        && after.reservationId == reservationId;
    }

    /* Staff move a booking on only as checkout and return do,
       each proven by its rental in the same write: confirmed
       to checked out with an active rental, checked out to
       completed with the rental returned. Anything else —
       a cancellation by another name — is an administrator's. */
    function staffBookingStatusChange() {
      let from = resource.data.get("status", null);
      let to = request.resource.data.get("status", null);

      return from == to
        || (
          from == "confirmed"
          && to == "checked_out"
          && request.resource.data.get("rentalId", null)
              is string
          && getAfter(
            /databases/$(database)/documents/rentals/$(request.resource.data.rentalId)
          ).data.status == "active"
        )
        || (
          from == "checked_out"
          && to == "completed"
          && resource.data.get("rentalId", null) is string
          && getAfter(
            /databases/$(database)/documents/rentals/$(resource.data.rentalId)
          ).data.status == "returned"
        );
    }

    /* Staff book at the vehicle's own daily rate; a discount
       on it can only be asked for, never applied, by them. */
    function bookingPricedFromVehicle(reservationId) {
      let data = request.resource.data;
      let discountStatus = data.get(
        "dailyRateDiscountStatus", null
      );

      return data.get("status", null) != "confirmed"
        || (
          data.get("rateSnapshot", {})
              .get("dailyCents", null)
            == get(
              /databases/$(database)/documents/vehicles/$(data.vehicleId)
            ).data.get("rates", {}).get("dailyCents", null)
          && (
            discountStatus == null
            || (
              discountStatus == "pending"
              && getAfter(
                /databases/$(database)/documents/rentalDiscounts/$(data.dailyRateDiscountId)
              ).data.reservationId == reservationId
            )
          )
        );
    }

    match /reservations/{reservationId} {

      allow read: if isStaff();

      allow create: if isStaff()
        && (
          isAdmin()
          || bookingPricedFromVehicle(reservationId)
        );

      /* A booking is only cancelled with a reason: the
         cancelled list on Bookings says why each one went.
         Only an administrator cancels; anyone else asks, and
         the booking carries the request it is waiting on. */
      allow update: if isStaff()
        && (
          request.resource.data.get("status", null)
              != "cancelled"
          || resource.data.get("status", null)
              == "cancelled"
          || (
            isAdmin()
            && request.resource.data.get(
              "cancellationReason", null
            ) is string
            && request.resource.data.cancellationReason
                .trim().size() > 0
          )
        )
        && (
          isAdmin()
          || cancellationLockUntouched()
          || openingCancellationRequest(reservationId)
          || withdrawingCancellationAtCheckout()
        )
        && (
          isAdmin()
          || (
            request.resource.data.get("rateSnapshot", null)
                == resource.data.get("rateSnapshot", null)
            && (
              discountLockUntouched()
              || openingDiscountRequest(reservationId)
            )
            && staffBookingStatusChange()
          )
        );

      allow delete: if isAdmin();
    }


    /* =========================================================
       CANCELLATION REQUESTS
       ========================================================= */

    match /cancellationRequests/{requestId} {

      allow read: if isStaff();

      /* Staff ask, in their own name, for a booking that is
         still confirmed, and the booking is locked to this
         request in the same write. */
      allow create: if isStaff()
        && pendingRequestInOwnName()
        && request.resource.data.reservationId is string
        && get(
          /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
        ).data.status == "confirmed"
        && getAfter(
          /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
        ).data.cancellationRequestId == requestId;

      /* An administrator approves only by cancelling the
         booking in the same write, or rejects with a note. */
      allow update: if adminDecidesPending()
        && rejectionExplained()
        && (
          request.resource.data.status != "approved"
          || getAfter(
            /databases/$(database)/documents/reservations/$(resource.data.reservationId)
          ).data.status == "cancelled"
        );

      /* Checking the booking out withdraws the request. */
      allow update: if isStaff()
        && resource.data.status == "pending"
        && request.resource.data.status == "withdrawn"
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "status",
              "withdrawnBy",
              "withdrawnAt",
              "updatedAt"
            ])
        && request.resource.data.withdrawnBy
            == request.auth.uid
        && getAfter(
          /databases/$(database)/documents/reservations/$(resource.data.reservationId)
        ).data.status == "checked_out";

      allow delete: if false;
    }


    /* =========================================================
       CONTRACT REVIEW AND FINALISATION
       ========================================================= */

    match /reservationContracts/{reservationId} {

      allow read: if isStaff();

      /* A contract enters the workflow already waiting for
         review, so there is no separate draft record to keep
         in step with the booking it describes. */
      allow create: if isStaff()
        && request.resource.data.status == "in_review"
        && request.resource.data.version == 1;

      /* Resubmission after a rejection. The version advances
         so an approved snapshot is always attributable to
         the round of review that produced it. */
      allow update: if isStaff()
        && resource.data.status == "rejected"
        && request.resource.data.status == "in_review"
        && request.resource.data.version
            == resource.data.version + 1;

      /* Only an administrator finalises a contract, and only
         one that is actually waiting for review. An approved
         contract is terminal: no later update matches. */
      allow update: if isAdmin()
        && resource.data.status == "in_review"
        && request.resource.data.status in [
          "approved",
          "rejected"
        ]
        && request.resource.data.version
            == resource.data.version;

      allow delete: if false;
    }


    match /reservationContracts/{reservationId}/versions/{version} {

      /* The frozen agreement: written once by the
         administrator who approved it, and immutable from
         then on, so what was sent can always be reproduced. */
      allow read: if isStaff();

      allow create: if isAdmin();

      allow update, delete: if false;
    }


    match /reservationContracts/{reservationId}/deliveries/{deliveryId} {

      /* Append-only delivery receipts recording when a
         contract was emailed, to whom, and which version. */
      allow read, create: if isStaff();

      allow update, delete: if false;
    }


    /* =========================================================
       RENTALS
       ========================================================= */

    function validFuelLevel(value) {
      return value in [
        "empty",
        "one_eighth",
        "quarter",
        "three_eighths",
        "half",
        "five_eighths",
        "three_quarters",
        "seven_eighths",
        "full"
      ];
    }

    /* A rental being closed: the fuel it came back with is
       required, and the odometer is either not recorded (null,
       never a made-up 0) or a reading not below the pickup. */
    function returnRecordValid() {
      return validFuelLevel(
          request.resource.data.get("returnFuelLevel", null)
        )
        && (
          request.resource.data.get("returnOdometerKm", null)
              == null
          || (
            request.resource.data.returnOdometerKm is number
            && request.resource.data.returnOdometerKm >= 0
            && (
              !(resource.data.get("pickupOdometerKm", null)
                  is number)
              || request.resource.data.returnOdometerKm
                  >= resource.data.pickupOdometerKm
            )
          )
        );
    }

    function closingRental() {
      return request.resource.data.get("status", null)
          == "returned"
        && resource.data.get("status", null) != "returned";
    }

    /* The return time sits between the vehicle going out —
       the booked pickup, or the checkout if it was collected
       early — and now (five minutes allowed for a browser
       clock running fast). A return more than fifteen minutes
       in the past is backdated, and only an administrator
       writes one directly; anyone else's goes through a
       returnRequests approval. One minute beyond the fifteen
       absorbs clock drift and the time the write takes. */
    function returnTimeAllowed() {
      let returnedAt = request.resource.data.get(
        "actualReturnAt", null
      );

      return returnedAt is timestamp
        && returnedAt
            <= request.time + duration.value(5, "m")
        && (
          !(resource.data.get("pickupAt", null)
              is timestamp)
          || returnedAt >= resource.data.pickupAt
          || (
            resource.data.get("createdAt", null)
                is timestamp
            && returnedAt >= resource.data.createdAt
          )
        )
        && (
          isAdmin()
          || (
            returnedAt
                >= request.time - duration.value(16, "m")
            && resource.data.get(
                "returnRequestStatus", null
              ) != "pending"
          )
        );
    }

    function returnLockUntouched() {
      return !request.resource.data.diff(resource.data)
        .affectedKeys()
        .hasAny([
          "returnRequestId",
          "returnRequestStatus",
          "returnApprovedBy",
          "returnApprovedByNameSnapshot"
        ]);
    }

    /* Staff point the rental at the backdated return they
       have just asked for, and only when none is waiting. */
    function openingReturnRequest(rentalId) {
      let requestId =
        request.resource.data.get(
          "returnRequestId", null
        );
      let after = getAfter(
        /databases/$(database)/documents/returnRequests/$(requestId)
      ).data;

      return resource.data.get(
            "returnRequestStatus", null
          ) != "pending"
        && request.resource.data.diff(resource.data)
            .affectedKeys()
            .hasOnly([
              "returnRequestId",
              "returnRequestStatus",
              "updatedAt"
            ])
        && request.resource.data.returnRequestStatus
            == "pending"
        && requestId is string
        && after.status == "pending"
        && after.rentalId == rentalId;
    }

    /* A rental checked out by staff is priced at its
       booking's rates, not at rates of its own. */
    function rentalPricedFromBooking() {
      return request.resource.data.get("status", null)
          != "active"
        || request.resource.data.get("rateSnapshot", null)
          == get(
            /databases/$(database)/documents/reservations/$(request.resource.data.reservationId)
          ).data.get("rateSnapshot", null);
    }

    match /rentals/{rentalId} {

      allow read: if isStaff();

      allow create: if isStaff()
        && (isAdmin() || rentalPricedFromBooking());

      allow update: if isStaff()
        && (
          !closingRental()
          || (returnRecordValid() && returnTimeAllowed())
        )
        && (
          isAdmin()
          || closingRental()
          || !request.resource.data.diff(resource.data)
              .affectedKeys().hasAny(["actualReturnAt"])
        )
        && (
          isAdmin()
          || returnLockUntouched()
          || openingReturnRequest(rentalId)
        )
        && (
          isAdmin()
          || request.resource.data.get("rateSnapshot", null)
              == resource.data.get("rateSnapshot", null)
        );

      allow delete: if isAdmin();
    }


    /* =========================================================
       BACKDATED RETURN REQUESTS
       ========================================================= */

    match /returnRequests/{requestId} {

      allow read: if isStaff();

      /* Staff ask, in their own name, for a rental still out,
         and the rental is locked to this request in the same
         write. */
      allow create: if isStaff()
        && pendingRequestInOwnName()
        && request.resource.data.rentalId is string
        && request.resource.data.requestedReturnAt
            is timestamp
        && get(
          /databases/$(database)/documents/rentals/$(request.resource.data.rentalId)
        ).data.status in ["active", "overdue"]
        && getAfter(
          /databases/$(database)/documents/rentals/$(request.resource.data.rentalId)
        ).data.returnRequestId == requestId;

      /* An administrator approves only by closing the rental
         at the time that was asked for, in the same write, or
         rejects with a note. */
      allow update: if adminDecidesPending()
        && rejectionExplained()
        && (
          request.resource.data.status != "approved"
          || (
            getAfter(
              /databases/$(database)/documents/rentals/$(resource.data.rentalId)
            ).data.status == "returned"
            && getAfter(
              /databases/$(database)/documents/rentals/$(resource.data.rentalId)
            ).data.actualReturnAt
                == resource.data.requestedReturnAt
          )
        );

      allow delete: if false;
    }


    match /rentals/{rentalId}/inspections/{inspectionId} {

      allow read: if isStaff();

      allow create, update: if isStaff();

      allow delete: if isAdmin();
    }


    match /rentals/{rentalId}/extensions/{extensionId} {

      /* One record per extension, keyed by its idempotency
         key. Append-only: an extension that has been priced
         and charged cannot be rewritten from a browser. */
      allow read, create: if isStaff();

      allow update, delete: if false;
    }


    /* =========================================================
       RENTAL FINANCIALS
       ========================================================= */

    match /rentalFinancials/{rentalId} {

      allow read: if isStaff();

      allow create, update: if isStaff();

      allow delete: if isAdmin();
    }


    /* =========================================================
       PAYMENTS
       ========================================================= */

    match /payments/{paymentId} {

      allow read: if isStaff();

      allow create: if isStaff();

      allow update, delete: if isAdmin();
    }


    /* =========================================================
       DISCOUNTS
       ========================================================= */

    /* A discount on the daily rate: the amounts agree with
       each other and with the booking's rate, the booking is
       locked to it in the same write, and an approved one has
       already re-priced the booking. */
    function dailyRateDiscountValid(discountId) {
      let data = request.resource.data;
      let booking = getAfter(
        /databases/$(database)/documents/reservations/$(data.reservationId)
      ).data;

      return data.get("kind", null) == "daily_rate"
        && data.reservationId is string
        && data.keys().hasAll(["rentalId"])
        && (data.rentalId == null || data.rentalId is string)
        && data.get("reason", null) is string
        && data.reason.trim().size() > 0
        && data.reason.size() <= 500
        && data.originalDailyCents is int
        && data.discountedDailyCents is int
        && data.discountedDailyCents >= 1
        && data.discountedDailyCents
            < data.originalDailyCents
        && data.amountCents
            == data.originalDailyCents
              - data.discountedDailyCents
        && (
          (
            data.discountType == "amount"
            && data.discountValue == data.amountCents
          )
          || (
            data.discountType == "percent"
            && data.discountValue is number
            && data.discountValue > 0
            && data.discountValue < 100
            && math.abs(
              math.round(
                data.originalDailyCents
                  * (100.0 - data.discountValue)
                  / 100.0
              ) - data.discountedDailyCents
            ) <= 1
          )
        )
        && booking.dailyRateDiscountId == discountId
        && (
          (
            data.status == "pending"
            && booking.rateSnapshot.dailyCents
                == data.originalDailyCents
          )
          || (
            data.status == "approved"
            && booking.rateSnapshot.dailyCents
                == data.discountedDailyCents
          )
        );
    }

    match /rentalDiscounts/{discountId} {

      allow read: if isStaff();

      /* Anyone on staff may offer a discount on the daily rate,
         in their own name, and it waits for an administrator.
         Only an administrator's own discount may be approved
         as it is written. A discount off the balance can no
         longer be offered at all. */
      allow create: if isStaff()
        && request.resource.data.requestedBy
            == request.auth.uid
        && request.resource.data.amountCents is int
        && request.resource.data.amountCents > 0
        && (
          request.resource.data.status == "pending"
          || (
            isAdmin()
            && request.resource.data.status == "approved"
            && request.resource.data.reviewedBy
                == request.auth.uid
          )
        )
        && dailyRateDiscountValid(discountId);

      /* Only an administrator decides, only once, in their own
         name, never their own request, and never by changing
         what was asked for. Approving a discount on the daily
         rate re-prices the booking in the same write. Waiting
         discounts off the balance are still decided here. */
      allow update: if adminDecidesPending()
        && (
          resource.data.get("kind", null) != "daily_rate"
          || request.resource.data.status != "approved"
          || getAfter(
            /databases/$(database)/documents/reservations/$(resource.data.reservationId)
          ).data.rateSnapshot.dailyCents
              == resource.data.discountedDailyCents
        );

      allow delete: if false;
    }


    /* =========================================================
       REFUNDS
       ========================================================= */

    match /refunds/{refundId} {

      allow read: if isAdmin();

      allow create, update, delete: if isAdmin();
    }


    /* =========================================================
       FINANCIAL LEDGER
       ========================================================= */

    match /financialLedger/{entryId} {

      allow read: if isAdmin();

      allow create: if isStaff();

      allow update, delete: if isAdmin();
    }


    /* =========================================================
       VEHICLE EXPENSES
       ========================================================= */

    match /vehicleExpenses/{expenseId} {

      /* Recording an expense is operational work, so any
         approved account may add one and read back what it
         recorded itself — a query it can only run by
         filtering on its own uid. Everybody else's entries,
         and therefore the cost side of the business, stay
         with an administrator. */
      allow read: if isAdmin()
        || (
          isStaff()
          && resource.data.recordedBy
              == request.auth.uid
        );

      allow create: if isStaff()
        && request.resource.data.recordedBy
            == request.auth.uid;

      allow update, delete: if isAdmin();
    }


    /* =========================================================
       AUDIT LOGS
       ========================================================= */

    match /auditLogs/{auditId} {

      allow read: if isAdmin();

      allow create: if isStaff();

      allow update, delete: if isAdmin();
    }


    /* =========================================================
       IDEMPOTENCY
       ========================================================= */

    match /idempotencyKeys/{key} {

      /* Records are create-only so a completed payment,
         refund or expense cannot be replayed by clearing
         its key. */
      allow read, create: if isStaff();

      allow update, delete: if false;
    }


    /* =========================================================
       DEFAULT DENY
       ========================================================= */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}