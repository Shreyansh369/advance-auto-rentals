{
  "name": "advance-auto-rentals",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": { "node": ">=22 <25", "pnpm": ">=11" },
  "pnpm": {
},
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit --passWithNoTests",
    "test:watch": "vitest tests/unit",
    "test:rules": "firebase emulators:exec --only auth,firestore,storage \"pnpm vitest run tests/rules\"",
    "functions:build": "pnpm --dir functions build",
    "import:inventory": "tsx scripts/import-inventory.ts",
    "bootstrap:staff": "tsx scripts/bootstrap-staff.ts",
    "bootstrap:admin": "tsx scripts/bootstrap-admin.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm functions:build && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "date-fns": "^4.1.0",
    "firebase": "^12.17.0",
    "lucide-react": "^0.544.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-hook-form": "^7.62.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@firebase/rules-unit-testing": "^5.0.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^24.5.2",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.35.0",
    "eslint-config-next": "^16.0.0",
    "firebase-admin": "^13.5.0",
    "firebase-tools": "^14.18.0",
    "prettier": "^3.6.2",
    "@tailwindcss/postcss": "^4.1.13",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "xlsx": "^0.18.5"
  }
}
